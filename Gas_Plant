<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Gas Flow & Pressure Control - Multi Plant Client</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #1E222A;
            color: #FFFFFF;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .mobile-tab-bar {
            display: none;
            background-color: #15181E;
            border-bottom: 2px solid #3A404D;
            padding: 6px;
            gap: 6px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .tab-btn {
            flex: 1;
            padding: 10px 4px;
            background-color: #2B303C;
            color: #A0AAB0;
            border: 1px solid #3A404D;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            text-align: center;
            transition: all 0.2s ease;
            touch-action: manipulation;
        }

        .tab-btn.active {
            background-color: #00E676;
            color: #000;
            border-color: #00E676;
            box-shadow: 0 0 8px rgba(0, 230, 118, 0.4);
        }

        #dcs-workspace {
            display: flex;
            width: 100%;
            flex: 1;
            padding: 10px;
            gap: 10px;
            box-sizing: border-box;
            min-height: 0;
        }

        /* Yokogawa Faceplate Border Frame */
        .faceplate-border {
            background-color: #808080;
            padding: 3px;
            border: 2px outset #B0B0B0;
            width: 180px;
            flex-shrink: 0;
            border-radius: 4px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        }

        .faceplate {
            background-color: #C0C0C0;
            height: 100%;
            display: flex;
            flex-direction: column;
            padding: 4px;
            color: #000;
            border-radius: 2px;
        }

        .fp-header {
            background-color: #C0C0C0;
            border: 2px outset #FFF;
            padding: 6px 4px;
            font-family: 'Courier New', Courier, monospace;
            font-weight: bold;
            font-size: 13px;
            line-height: 1.2;
            text-align: center;
        }

        .status-box {
            background-color: #000000;
            border: 2px inset #808080;
            height: 54px;
            margin: 4px 0;
            position: relative;
        }

        .ind-sq {
            position: absolute;
            top: 6px;
            left: 35px;
            width: 18px;
            height: 14px;
            background-color: #00FF00;
            border-radius: 2px;
        }

        .lbl-mode-text {
            position: absolute;
            top: 20px;
            left: 6px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 11px;
            font-weight: bold;
            color: #00FFFF;
            white-space: pre;
        }

        .btn-ack {
            position: absolute;
            top: 10px;
            right: 8px;
            width: 44px;
            height: 32px;
            background-color: #4A5162;
            color: #FFF;
            border: 1px solid #000;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 3px;
            touch-action: manipulation;
        }

        .btn-mode {
            width: 100%;
            background-color: #3A404D;
            color: #FFF;
            border: 1px solid #000;
            font-weight: bold;
            font-size: 12px;
            padding: 8px 4px;
            cursor: pointer;
            margin-bottom: 4px;
            border-radius: 3px;
            touch-action: manipulation;
        }

        .readout-box {
            background-color: #000;
            border: 2px inset #808080;
            margin: 2px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2px 6px;
            font-family: 'Courier New', Courier, monospace;
            min-height: 28px;
            border-radius: 2px;
        }

        .readout-box.clickable {
            cursor: pointer;
        }

        .readout-box.clickable:active {
            background-color: #1a1a1a;
        }

        .readout-title {
            color: #FFF;
            font-size: 13px;
            font-weight: bold;
        }

        .readout-unit {
            color: #FFF;
            font-size: 11px;
        }

        .readout-val {
            color: #00FFFF;
            font-size: 14px;
            font-weight: bold;
        }

        #faceplateCanvasContainer {
            width: 100%;
            margin-top: 4px;
            display: flex;
            justify-content: center;
        }

        #faceplateCanvas {
            background-color: #C0C0C0;
            cursor: default;
            width: 100%;
            max-width: 200px;
            height: auto;
        }

        .right-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
            min-height: 0;
        }

        .trend-frame {
            flex: 1;
            min-height: 320px;
            background-color: #2B303C;
            border: 2px inset #121417;
            display: flex;
            flex-direction: column;
            position: relative;
            border-radius: 4px;
            overflow: hidden;
        }

        .trend-canvas-wrap {
            flex: 1;
            position: relative;
            width: 100%;
            min-height: 0;
            overflow: hidden;
        }

        #trendCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: block;
        }

        .trend-ctrl-bar {
            background-color: #1E222A;
            padding: 8px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px 12px;
            font-size: 11px;
            color: #00E676;
            font-weight: bold;
            border-top: 1px solid #3A404D;
            flex-shrink: 0;
        }

        .trend-ctrl-group {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .trend-ctrl-bar select,
        .trend-ctrl-bar input {
            background-color: #2B303C;
            color: #FFF;
            border: 1px solid #3A404D;
            font-family: 'Consolas', monospace;
            font-size: 12px;
            padding: 4px 6px;
            border-radius: 3px;
        }

        .inst-frame {
            background-color: #2B303C;
            border: 2px solid #3A404D;
            padding: 8px 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px 20px;
            align-items: center;
            border-radius: 4px;
            flex-shrink: 0;
        }

        .inst-sec {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            flex-wrap: wrap;
        }

        .inst-sec input[type="text"] {
            background-color: #121417;
            color: #FFF;
            border: 1px solid #3A404D;
            padding: 5px 8px;
            font-size: 12px;
            border-radius: 3px;
        }

        .inst-sec-title {
            color: #00E676;
            font-weight: bold;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 3px;
            font-weight: bold;
            font-size: 11px;
        }

        .status-connected {
            background-color: #00E676;
            color: #000;
        }

        .status-disconnected {
            background-color: #FF1744;
            color: #FFF;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.75);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            padding: 10px;
        }

        .modal-body {
            background-color: #2B303C;
            border: 2px solid #00E676;
            padding: 16px;
            width: 100%;
            max-width: 420px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8);
            border-radius: 6px;
        }

        .modal-title {
            color: #00E676;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 14px;
            border-bottom: 1px solid #3A404D;
            padding-bottom: 6px;
        }

        .modal-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            align-items: center;
            font-size: 12px;
            margin-bottom: 16px;
        }

        .modal-grid input[type="text"],
        .modal-grid input[type="number"],
        .modal-grid select {
            background: #121417;
            color: #FFF;
            border: 1px solid #3A404D;
            padding: 6px;
            font-family: 'Consolas', monospace;
            font-size: 12px;
            border-radius: 3px;
            width: 100%;
        }

        .modal-grid input:disabled {
            background: #252830;
            color: #666;
            border-color: #2A2D35;
        }

        .modal-btn-bar {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 10px;
        }

        .modal-btn {
            padding: 8px 16px;
            font-weight: bold;
            font-size: 12px;
            cursor: pointer;
            border: none;
            border-radius: 4px;
            touch-action: manipulation;
        }

        .btn-apply {
            background-color: #00E676;
            color: #000;
        }

        .btn-cancel {
            background-color: #606060;
            color: #FFF;
        }

        @media (max-width: 768px) {
            .mobile-tab-bar {
                display: flex;
            }

            #dcs-workspace {
                flex-direction: column;
                padding: 6px;
                gap: 8px;
            }

            .faceplate-border {
                width: 100%;
                max-width: 320px;
                margin: 0 auto;
            }

            .right-container {
                width: 100%;
            }

            .trend-frame {
                min-height: 300px;
            }

            .modal-grid {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .tab-content-hidden {
                display: none !important;
            }

            .inst-frame {
                flex-direction: column;
                align-items: stretch;
            }

            .inst-sec {
                justify-content: space-between;
            }
        }
    </style>
</head>

<body>

    <div class="mobile-tab-bar" id="mobileTabBar">
        <button class="tab-btn active" id="tabBtnController" onclick="switchMobileTab('controller')">🎛️
            Faceplate</button>
        <button class="tab-btn" id="tabBtnTrend" onclick="switchMobileTab('trend')">📈 Trend Chart</button>
        <button class="tab-btn" id="tabBtnServer" onclick="switchMobileTab('server')">⚙️ Server & Config</button>
    </div>

    <div id="dcs-workspace">

        <!-- YOKOGAWA FACEPLATE SECTION -->
        <div class="faceplate-border" id="secFaceplate">
            <div class="faceplate">
                <div class="fp-header" id="fpPlantTitle">PID #1<br>Controller</div>

                <div class="status-box">
                    <div id="indSq" class="ind-sq"></div>
                    <div id="lblModeText" class="lbl-mode-text">AUT&#10;NR</div>
                    <button class="btn-ack" onclick="acknowledgeAlarm()">ACK</button>
                </div>

                <button class="btn-mode" onclick="openModeDialog()">MODE...</button>

                <!-- READOUTS -->
                <div class="readout-box">
                    <span class="readout-title">PV</span>
                    <span id="lblPvVal" class="readout-val" style="color: #11fa30;">0.0</span>
                    <span id="lblPvUnit" class="readout-unit">MMSCFD</span>
                </div>

                <div class="readout-box clickable" onclick="openValueDialog('SP')">
                    <span class="readout-title">SV</span>
                    <span id="lblSpVal" class="readout-val" style="color: #fc0b1f;">50.0</span>
                    <span id="lblSvUnit" class="readout-unit">MMSCFD</span>
                </div>

                <div class="readout-box clickable" onclick="openValueDialog('MV')">
                    <span class="readout-title">MV</span>
                    <span id="lblMvVal" class="readout-val" style="color: #ebe706;">0.0</span>
                    <span class="readout-unit">%</span>
                </div>

                <!-- READOUT KRITERIA KINERJA IAE -->
                <div class="readout-box clickable" onclick="resetIAE()" title="Klik untuk Reset IAE">
                    <span class="readout-title">IAE</span>
                    <span id="lblIaeVal" class="readout-val" style="color: #ff9800;">0.00</span>
                    <span class="readout-unit"></span>
                </div>

                <!-- GRAPHICAL FACEPLATE CANVAS -->
                <div id="faceplateCanvasContainer">
                    <canvas id="faceplateCanvas" width="200" height="295"></canvas>
                </div>
            </div>
        </div>

        <div class="right-container">
            <!-- TREND CHART PANEL -->
            <div class="trend-frame" id="secTrend">
                <div class="trend-canvas-wrap" id="trendCanvasWrap">
                    <canvas id="trendCanvas"></canvas>
                </div>
                <div class="trend-ctrl-bar">
                    <div class="trend-ctrl-group">
                        <span>Plant Target:</span>
                        <select id="cbPlantSelect" onchange="changeActivePlant(this.value)">
                            <!-- Akan diisi otomatis oleh JavaScript -->
                        </select>
                    </div>

                    <div class="trend-ctrl-group">
                        <span>Span:</span>
                        <input type="number" id="txtTrendSpan" value="100" min="5" max="3600" style="width: 60px;"
                            onchange="changeTrendSpan(this.value)">
                        <span>s</span>
                    </div>

                    <div class="trend-ctrl-group">
                        <span>Refresh:</span>
                        <select id="cbTrendRefresh" onchange="changeTrendRefresh(this.value)">
                            <option value="100" selected>100 ms</option>
                            <option value="500">500 ms</option>
                            <option value="1000">1 s</option>
                        </select>
                    </div>

                    <div class="trend-ctrl-group">
                        <span>Nilai IAE:</span>
                        <span id="txtIaeVal"
                            style="color: #FF9800; font-family: 'Consolas', monospace; font-size: 13px;">0.00</span>
                        <button class="btn-apply" onclick="resetIAE()"
                            style="padding: 3px 8px; font-size: 11px;">Reset</button>
                    </div>
                </div>
            </div>

            <!-- INSTRUCTOR CONSOLE / SERVER CONNECTION STATUS -->
            <div class="inst-frame" id="secServer">
                <div class="inst-sec">
                    <span class="inst-sec-title">Server IP:</span>
                    <input type="text" id="txtServerIp" value="127.0.0.1" style="width: 120px;">
                    <button class="btn-apply" onclick="reconnectServer()"
                        style="padding: 4px 10px; font-size: 11px;">Connect</button>
                </div>

                <div class="inst-sec">
                    <span class="inst-sec-title">Status Server:</span>
                    <span id="netStatusBadge" class="status-badge status-disconnected">TERPUTUS</span>
                </div>
            </div>
        </div>

    </div>

    <div id="modalOverlay" class="modal-overlay">
        <div class="modal-body">
            <div id="modalTitle" class="modal-title">Config Title</div>
            <div id="modalContent" class="modal-grid"></div>
            <div class="modal-btn-bar" id="modalBtnBar">
                <button class="modal-btn btn-apply" id="btnModalApply" onclick="submitModal()">Apply / Save</button>
                <button class="modal-btn btn-cancel" onclick="closeModal()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        /* =================================================================
           STRUKTUR KONFIGURASI PARAMETER PID (50 PLANT SUPPORT)
           ================================================================= */
        class PIDConfig {
            constructor(Kc = 2.0, Ti = 4.0, Td = 0.05, sampleTime = 0.1) {
                this.Kc = Math.abs(Kc);
                this.Ti = Ti;
                this.Td = Td;
                this.sampleTime = sampleTime;

                this.enableLinearization = false;
                this.R = 50.0;
                this.action = "REVERSE";
                this.valveType = "FC";
            }
        }

        const NUM_PLANTS = 50;

        // Helper untuk menjamin variabel numerik tidak pernah bernilai NaN / Infinity
        function safeNum(val, defaultVal = 0.0) {
            let n = parseFloat(val);
            return (isNaN(n) || !isFinite(n)) ? defaultVal : n;
        }

        const state = {
            activePlantIndex: 0,
            plants: Array.from({ length: NUM_PLANTS }, () => ({
                pid: new PIDConfig(1.0, 4.0, 0.0, 0.1),
                sp_pct: 50.0,  // Nilai awal SP 50%
                pv_pct: 0.0,   // Nilai awal PV 0%
                mv: 0.0,       // Nilai awal MV 0%
                mode: "AUT",
                iae: 0.0,
                spBuffer: [],
                pvBuffer: [],
                mvBuffer: [],
                timeBuffer: []
            })),

            sim_time: 0.0,
            dt: 0.1,
            eu_unit: "MMSCFD",
            eu_min: 0.0,
            eu_max: 100.0,

            trendSpanSec: 100,
            trendRefreshMs: 100,
            maxPoints: 1000,
            simTimer: null,

            alarmStatus: "NR",
            alarmAck: true,
            blinkState: false,

            ws: null,
            wsUrl: "ws://127.0.0.1:8765",
            currentTab: 'controller'
        };

        function pctToEu(pct) {
            let validPct = safeNum(pct, 0.0);
            let min = safeNum(state.eu_min, 0.0);
            let max = safeNum(state.eu_max, 100.0);
            return min + (validPct / 100.0) * (max - min);
        }

        function euToPct(eu) {
            let validEu = safeNum(eu, 0.0);
            let min = safeNum(state.eu_min, 0.0);
            let max = safeNum(state.eu_max, 100.0);
            let span = max - min;
            return span === 0 ? 0.0 : ((validEu - min) / span) * 100.0;
        }

        function populatePlantDropdown() {
            const selectEl = document.getElementById("selPlant") || document.getElementById("cmbPlant") || document.getElementById("selectPlant");
            if (selectEl) {
                selectEl.innerHTML = "";
                for (let i = 0; i < NUM_PLANTS; i++) {
                    const opt = document.createElement("option");
                    opt.value = i;
                    opt.textContent = `Plant #${i + 1}`;
                    selectEl.appendChild(opt);
                }
                selectEl.value = state.activePlantIndex;
            }
        }

        function switchMobileTab(tabName) {
            state.currentTab = tabName;
            const secFaceplate = document.getElementById("secFaceplate");
            const secTrend = document.getElementById("secTrend");
            const secServer = document.getElementById("secServer");

            const btnController = document.getElementById("tabBtnController");
            const btnTrend = document.getElementById("tabBtnTrend");
            const btnServer = document.getElementById("tabBtnServer");

            if (btnController) btnController.classList.remove("active");
            if (btnTrend) btnTrend.classList.remove("active");
            if (btnServer) btnServer.classList.remove("active");

            if (window.innerWidth <= 768) {
                if (secFaceplate) secFaceplate.classList.add("tab-content-hidden");
                if (secTrend) secTrend.classList.add("tab-content-hidden");
                if (secServer) secServer.classList.add("tab-content-hidden");

                if (tabName === 'controller' && secFaceplate) {
                    secFaceplate.classList.remove("tab-content-hidden");
                    if (btnController) btnController.classList.add("active");
                } else if (tabName === 'trend' && secTrend) {
                    secTrend.classList.remove("tab-content-hidden");
                    if (btnTrend) btnTrend.classList.add("active");
                } else if (tabName === 'server' && secServer) {
                    secServer.classList.remove("tab-content-hidden");
                    if (btnServer) btnServer.classList.add("active");
                }
            } else {
                if (secFaceplate) secFaceplate.classList.remove("tab-content-hidden");
                if (secTrend) secTrend.classList.remove("tab-content-hidden");
                if (secServer) secServer.classList.remove("tab-content-hidden");
            }

            setTimeout(() => {
                drawTrendChart();
                drawYokogawaFaceplate();
            }, 50);
        }

        window.addEventListener("resize", () => {
            if (window.innerWidth > 768) {
                const secFaceplate = document.getElementById("secFaceplate");
                const secTrend = document.getElementById("secTrend");
                const secServer = document.getElementById("secServer");
                if (secFaceplate) secFaceplate.classList.remove("tab-content-hidden");
                if (secTrend) secTrend.classList.remove("tab-content-hidden");
                if (secServer) secServer.classList.remove("tab-content-hidden");
            } else {
                switchMobileTab(state.currentTab);
            }
            drawTrendChart();
            drawYokogawaFaceplate();
        });

        function initWebSocket() {
            const ipInput = document.getElementById("txtServerIp");
            const ip = ipInput ? ipInput.value.trim() : "127.0.0.1";
            state.wsUrl = `ws://${ip}:8765`;

            if (state.ws) {
                state.ws.close();
            }

            try {
                state.ws = new WebSocket(state.wsUrl);

                state.ws.onopen = () => {
                    const badge = document.getElementById("netStatusBadge");
                    if (badge) {
                        badge.innerText = "TERHUBUNG (50 PLANTS)";
                        badge.className = "status-badge status-connected";
                    }
                    sendEuMaxToServer(state.eu_max);
                };

                state.ws.onmessage = (event) => {
                    try {
                        const data = JSON.parse(event.data);

                        if (data.eu_max !== undefined && data.eu_max !== null) {
                            let parsedMax = safeNum(data.eu_max, 100.0);
                            if (parsedMax > state.eu_min) {
                                state.eu_max = parsedMax;
                            }
                        }

                        if (data.pv || data.sp || data.mv || data.mode) {
                            for (let i = 0; i < NUM_PLANTS; i++) {
                                const p = state.plants[i];

                                if (Array.isArray(data.pv) && data.pv[i] !== undefined && data.pv[i] !== null) {
                                    p.pv_pct = euToPct(safeNum(data.pv[i], 0.0));
                                }
                                if (Array.isArray(data.sp) && data.sp[i] !== undefined && data.sp[i] !== null) {
                                    p.sp_pct = euToPct(safeNum(data.sp[i], 50.0));
                                }
                                if (Array.isArray(data.mv) && data.mv[i] !== undefined && data.mv[i] !== null) {
                                    p.mv = safeNum(data.mv[i], 0.0);
                                }
                                if (Array.isArray(data.mode) && data.mode[i] !== undefined) {
                                    p.mode = data.mode[i];
                                }
                            }
                            updateUIReadouts();
                        }
                    } catch (e) {
                        console.error("Kesalahan membaca JSON WebSocket:", e);
                    }
                };

                state.ws.onclose = () => {
                    const badge = document.getElementById("netStatusBadge");
                    if (badge) {
                        badge.innerText = "TERPUTUS";
                        badge.className = "status-badge status-disconnected";
                    }
                };

                state.ws.onerror = () => {
                    if (state.ws) state.ws.close();
                };
            } catch (e) {
                console.error("Gagal membuka koneksi WebSocket:", e);
            }
        }

        function reconnectServer() {
            initWebSocket();
        }

        function sendSpToServer(plantIdx, spValPct) {
            if (state.ws && state.ws.readyState === WebSocket.OPEN) {
                state.ws.send(JSON.stringify({
                    command: "write_sp",
                    plant_index: plantIdx,
                    sp_value: pctToEu(spValPct)
                }));
            }
        }

        function sendMvToServer(plantIdx, mvVal) {
            if (state.ws && state.ws.readyState === WebSocket.OPEN) {
                state.ws.send(JSON.stringify({
                    command: "write_mv",
                    plant_index: plantIdx,
                    mv_value: safeNum(mvVal, 0.0)
                }));
            }
        }

        function sendModeToServer(plantIdx, modeVal) {
            if (state.ws && state.ws.readyState === WebSocket.OPEN) {
                state.ws.send(JSON.stringify({
                    command: "write_mode",
                    plant_index: plantIdx,
                    mode: modeVal
                }));
            }
        }

        function sendPidConfigToServer(plantIdx, pidConfig) {
            if (state.ws && state.ws.readyState === WebSocket.OPEN) {
                state.ws.send(JSON.stringify({
                    command: "write_pid_config",
                    plant_index: plantIdx,
                    kc: pidConfig.Kc,
                    ti: pidConfig.Ti,
                    td: pidConfig.Td,
                    action: pidConfig.action,
                    valve_type: pidConfig.valveType,
                    linearization: pidConfig.enableLinearization,
                    r_val: pidConfig.R
                }));
            }
        }

        function sendEuMaxToServer(euMaxVal) {
            if (state.ws && state.ws.readyState === WebSocket.OPEN) {
                state.ws.send(JSON.stringify({
                    command: "write_eu_max",
                    eu_max: safeNum(euMaxVal, 100.0)
                }));
            }
        }

        function updateSimulation() {
            state.sim_time += state.dt;

            for (let i = 0; i < NUM_PLANTS; i++) {
                const p = state.plants[i];

                let pvEu = pctToEu(p.pv_pct);
                let spEu = pctToEu(p.sp_pct);

                const absError = Math.abs(spEu - pvEu);
                if (!isNaN(absError) && isFinite(absError)) {
                    p.iae += absError * state.dt;
                }

                p.spBuffer.push(spEu);
                p.pvBuffer.push(pvEu);
                p.mvBuffer.push(safeNum(p.mv, 0.0));
                p.timeBuffer.push(state.sim_time);

                while (p.spBuffer.length > state.maxPoints) {
                    p.spBuffer.shift();
                    p.pvBuffer.shift();
                    p.mvBuffer.shift();
                    p.timeBuffer.shift();
                }
            }

            drawYokogawaFaceplate();
            drawTrendChart();
            updateUIReadouts();
        }

        function updateUIReadouts() {
            const p = state.plants[state.activePlantIndex];
            if (!p) return;

            const lblPv = document.getElementById("lblPvVal");
            const lblSp = document.getElementById("lblSpVal");
            const lblMv = document.getElementById("lblMvVal");
            const lblIae = document.getElementById("lblIaeVal");
            const txtIae = document.getElementById("txtIaeVal");

            let pvEu = pctToEu(p.pv_pct);
            let spEu = pctToEu(p.sp_pct);
            let mvVal = safeNum(p.mv, 0.0);
            let iaeVal = safeNum(p.iae, 0.0);

            if (lblPv) lblPv.innerText = pvEu.toFixed(2);
            if (lblSp) lblSp.innerText = spEu.toFixed(2);
            if (lblMv) lblMv.innerText = mvVal.toFixed(1);
            if (lblIae) lblIae.innerText = iaeVal.toFixed(2);
            if (txtIae) txtIae.innerText = iaeVal.toFixed(2);
        }

        function resetIAE() {
            const p = state.plants[state.activePlantIndex];
            if (p) {
                p.iae = 0.0;
                updateUIReadouts();
            }
        }

        function changeActivePlant(val) {
            let idx = parseInt(val);
            if (!isNaN(idx) && idx >= 0 && idx < NUM_PLANTS) {
                state.activePlantIndex = idx;
                const titleEl = document.getElementById("fpPlantTitle");
                if (titleEl) {
                    titleEl.innerHTML = `PID #${state.activePlantIndex + 1}<br>Controller`;
                }
                updateUIReadouts();
                drawYokogawaFaceplate();
                drawTrendChart();
            }
        }

        function updateTrendConfig() {
            state.dt = safeNum(state.trendRefreshMs / 1000.0, 0.1);
            state.maxPoints = Math.max(10, Math.floor(state.trendSpanSec / state.dt));

            for (let i = 0; i < NUM_PLANTS; i++) {
                state.plants[i].pid.sampleTime = state.dt;
            }

            if (state.simTimer) {
                clearInterval(state.simTimer);
            }
            state.simTimer = setInterval(updateSimulation, state.trendRefreshMs);
        }

        function changeTrendRefresh(val) {
            state.trendRefreshMs = parseInt(val) || 100;
            updateTrendConfig();
        }

        function changeTrendSpan(val) {
            let v = parseFloat(val);
            if (!isNaN(v) && v > 0) {
                state.trendSpanSec = v;
                updateTrendConfig();
            }
        }

        function drawYokogawaFaceplate() {
            const fpCanvas = document.getElementById("faceplateCanvas");
            if (!fpCanvas) return;
            const fpCtx = fpCanvas.getContext("2d");
            if (!fpCtx) return;

            fpCtx.clearRect(0, 0, fpCanvas.width, fpCanvas.height);
            state.blinkState = !state.blinkState;

            const p = state.plants[state.activePlantIndex];

            let indSq = document.getElementById("indSq");
            let boxColor = "#00FF00";
            if (state.alarmStatus === "BAD") boxColor = (!state.alarmAck && state.blinkState) ? "#FF0000" : "#800080";
            else if (["HH", "LL"].includes(state.alarmStatus)) boxColor = (!state.alarmAck && state.blinkState) ? "#FF0000" : "#990000";
            else if (["HI", "LO"].includes(state.alarmStatus)) boxColor = (!state.alarmAck && state.blinkState) ? "#FFFF00" : "#999900";
            if (indSq) indSq.style.backgroundColor = boxColor;

            const lblModeText = document.getElementById("lblModeText");
            if (lblModeText) lblModeText.innerText = `${p.mode}\n${state.alarmStatus}`;

            let btnAck = document.querySelector(".btn-ack");
            if (btnAck) btnAck.style.backgroundColor = !state.alarmAck ? "#FF1744" : "#4A5162";

            const barTop = 25, barBottom = 232, barLeft = 88, barRight = 112;

            fpCtx.strokeStyle = "#505050";
            fpCtx.lineWidth = 2;
            fpCtx.fillStyle = "#000";
            fpCtx.fillRect(barLeft, barTop, barRight - barLeft, barBottom - barTop);
            fpCtx.strokeRect(barLeft, barTop, barRight - barLeft, barBottom - barTop);

            let pvH = (Math.max(0, Math.min(100, safeNum(p.pv_pct, 0))) / 100.0) * (barBottom - barTop);
            fpCtx.fillStyle = "#00FF00";
            fpCtx.fillRect(barLeft + 2, barBottom - pvH, (barRight - barLeft) - 4, Math.max(0, pvH - 1));

            let mvY = barBottom - ((Math.max(0, Math.min(100, safeNum(p.mv, 0))) / 100.0) * (barBottom - barTop));
            fpCtx.fillStyle = "#FFFF00";
            fpCtx.beginPath();
            fpCtx.moveTo(barLeft - 2, mvY);
            fpCtx.lineTo(barLeft - 14, mvY - 7);
            fpCtx.lineTo(barLeft - 14, mvY + 7);
            fpCtx.closePath();
            fpCtx.fill(); fpCtx.stroke();

            let spY = barBottom - ((Math.max(0, Math.min(100, safeNum(p.sp_pct, 50))) / 100.0) * (barBottom - barTop));
            fpCtx.fillStyle = "#FF0000";
            fpCtx.beginPath();
            fpCtx.moveTo(barRight + 2, spY);
            fpCtx.lineTo(barRight + 14, spY - 7);
            fpCtx.lineTo(barRight + 14, spY + 7);
            fpCtx.closePath();
            fpCtx.fill(); fpCtx.stroke();

            fpCtx.fillStyle = "#505050";
            fpCtx.font = "bold 9px Arial";
            fpCtx.fillText("MV(%)", barLeft - 30, barTop - 5);
            for (let v = 100; v >= 0; v -= 20) {
                let yPos = barBottom - ((v / 100.0) * (barBottom - barTop));
                fpCtx.strokeStyle = "#000";
                fpCtx.beginPath(); fpCtx.moveTo(barLeft - 20, yPos); fpCtx.lineTo(barLeft - 16, yPos); fpCtx.stroke();
                fpCtx.fillStyle = "#000";
                fpCtx.font = "9px Consolas";
                fpCtx.fillText(v.toString(), barLeft - 36, yPos + 3);
            }

            fpCtx.fillStyle = "#505050";
            fpCtx.font = "bold 9px Arial";
            fpCtx.fillText(`PV/SV`, barRight + 10, barTop - 15);
            fpCtx.fillText(`${state.eu_unit}`, barRight + 10, barTop - 5);
            for (let v = 100; v >= 0; v -= 20) {
                let yPos = barBottom - ((v / 100.0) * (barBottom - barTop));
                let euVal = pctToEu(v);
                fpCtx.strokeStyle = "#000";
                fpCtx.beginPath(); fpCtx.moveTo(barRight + 16, yPos); fpCtx.lineTo(barRight + 20, yPos); fpCtx.stroke();
                fpCtx.fillStyle = "#000";
                fpCtx.font = "9px Consolas";
                fpCtx.fillText(euVal.toFixed(1), barRight + 24, yPos + 3);
            }

            fpCtx.fillStyle = "#0000A0";
            fpCtx.strokeStyle = "#00FFFF";
            fpCtx.lineWidth = 2;
            fpCtx.beginPath();
            fpCtx.moveTo(100, 258); fpCtx.lineTo(116, 274); fpCtx.lineTo(100, 290); fpCtx.lineTo(84, 274);
            fpCtx.closePath();
            fpCtx.fill(); fpCtx.stroke();
        }

        function setupFaceplateEvents() {
            const fpCanvas = document.getElementById("faceplateCanvas");
            if (fpCanvas && !fpCanvas.dataset.listenerAttached) {
                fpCanvas.addEventListener("click", (e) => {
                    const rect = fpCanvas.getBoundingClientRect();
                    let scaleX = fpCanvas.width / rect.width;
                    let scaleY = fpCanvas.height / rect.height;
                    let x = (e.clientX - rect.left) * scaleX;
                    let y = (e.clientY - rect.top) * scaleY;
                    if (x >= 84 && x <= 116 && y >= 258 && y <= 290) {
                        openConfigDialog();
                    }
                });
                fpCanvas.dataset.listenerAttached = "true";
            }
        }

        function drawTrendChart() {
            const trendCanvas = document.getElementById("trendCanvas");
            if (!trendCanvas) return;
            const trendCtx = trendCanvas.getContext("2d");
            if (!trendCtx) return;

            let wrap = document.getElementById("trendCanvasWrap");
            if (!wrap) return;

            let w = wrap.clientWidth || 300;
            let h = wrap.clientHeight || 220;

            if (w <= 0 || h <= 0) return;

            trendCanvas.width = w;
            trendCanvas.height = h;

            trendCtx.fillStyle = "#121417";
            trendCtx.fillRect(0, 0, w, h);

            let padL = 45, padR = 15, padB = 20;
            let chartH = h - padB;
            let topH = chartH * 0.58, botH = chartH * 0.32;
            let botTop = topH + 15;

            const numXDivs = w < 480 ? 5 : 10;
            trendCtx.strokeStyle = "#2B303C";
            trendCtx.lineWidth = 1;

            const p = state.plants[state.activePlantIndex];

            let minT = p.timeBuffer.length > 0 ? p.timeBuffer[0] : 0.0;
            let maxT = p.timeBuffer.length >= state.maxPoints
                ? p.timeBuffer[p.timeBuffer.length - 1]
                : minT + (state.maxPoints * state.dt);

            for (let j = 0; j <= numXDivs; j++) {
                let x = padL + j * (w - padL - padR) / numXDivs;

                trendCtx.beginPath(); trendCtx.moveTo(x, 0); trendCtx.lineTo(x, topH); trendCtx.stroke();
                trendCtx.beginPath(); trendCtx.moveTo(x, botTop); trendCtx.lineTo(x, botTop + botH); trendCtx.stroke();

                let timeValAtDiv = minT + (j / numXDivs) * (maxT - minT);
                let timeStr = Math.round(timeValAtDiv) + "s";

                trendCtx.fillStyle = "#A0AAB0";
                trendCtx.font = "9px Arial";
                trendCtx.textAlign = "center";
                trendCtx.fillText(timeStr, x, botTop + botH + 14);
            }

            trendCtx.strokeStyle = "#2B303C";
            trendCtx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                let y = (topH / 4) * i;
                trendCtx.beginPath(); trendCtx.moveTo(padL, y); trendCtx.lineTo(w - padR, y); trendCtx.stroke();
            }

            let stepX = (w - padL - padR) / Math.max(1, (state.maxPoints - 1));
            let currentLen = p.spBuffer.length;

            let spanEu = state.eu_max - state.eu_min;
            if (spanEu <= 0) spanEu = 100.0;

            // Trend SV (Merah)
            trendCtx.strokeStyle = "#FF0000";
            trendCtx.lineWidth = 1.5;
            trendCtx.beginPath();
            for (let i = 0; i < currentLen; i++) {
                let yPct = (safeNum(p.spBuffer[i], state.eu_min) - state.eu_min) / spanEu;
                let y = topH - (yPct * topH);
                let x = padL + i * stepX;
                if (i === 0) trendCtx.moveTo(x, y); else trendCtx.lineTo(x, y);
            }
            trendCtx.stroke();

            // Trend PV (Hijau)
            trendCtx.strokeStyle = "#00FF00";
            trendCtx.lineWidth = 1.8;
            trendCtx.beginPath();
            for (let i = 0; i < currentLen; i++) {
                let yPct = (safeNum(p.pvBuffer[i], state.eu_min) - state.eu_min) / spanEu;
                let y = topH - (yPct * topH);
                let x = padL + i * stepX;
                if (i === 0) trendCtx.moveTo(x, y); else trendCtx.lineTo(x, y);
            }
            trendCtx.stroke();

            trendCtx.strokeStyle = "#2B303C";
            for (let i = 0; i <= 2; i++) {
                let y = botTop + (botH / 2) * i;
                trendCtx.beginPath(); trendCtx.moveTo(padL, y); trendCtx.lineTo(w - padR, y); trendCtx.stroke();
            }

            // Trend MV (Kuning)
            trendCtx.strokeStyle = "#FFFF00";
            trendCtx.lineWidth = 1.5;
            trendCtx.beginPath();
            for (let i = 0; i < currentLen; i++) {
                let yPct = safeNum(p.mvBuffer[i], 0.0) / 100.0;
                let y = (botTop + botH) - (yPct * botH);
                let x = padL + i * stepX;
                if (i === 0) trendCtx.moveTo(x, y); else trendCtx.lineTo(x, y);
            }
            trendCtx.stroke();

            trendCtx.fillStyle = "#A0AAB0";
            trendCtx.font = "9px Arial";
            trendCtx.textAlign = "left";
            trendCtx.fillText(state.eu_max.toFixed(0), 5, 12);
            trendCtx.fillText(state.eu_min.toFixed(0), 5, topH);
            trendCtx.fillText("100%", 5, botTop + 10);
            trendCtx.fillText("0%", 5, botTop + botH);
        }

        let activeModalCallback = null;

        function openModal(title, fieldsHtml, onApply, showApplyBtn = true) {
            const titleEl = document.getElementById("modalTitle");
            const contentEl = document.getElementById("modalContent");
            const btnApply = document.getElementById("btnModalApply");
            const overlay = document.getElementById("modalOverlay");

            if (titleEl) titleEl.innerText = title;
            if (contentEl) contentEl.innerHTML = fieldsHtml;
            if (btnApply) btnApply.style.display = showApplyBtn ? "inline-block" : "none";
            if (overlay) overlay.style.display = "flex";

            activeModalCallback = onApply;
        }

        function closeModal() {
            const overlay = document.getElementById("modalOverlay");
            if (overlay) overlay.style.display = "none";
            activeModalCallback = null;
        }

        function submitModal() {
            if (activeModalCallback) activeModalCallback();
            closeModal();
        }

        function toggleLinearizationRInput(val) {
            const rInput = document.getElementById("cfgR");
            if (rInput) {
                rInput.disabled = (val !== "ON");
            }
        }

        function openModeDialog() {
            const p = state.plants[state.activePlantIndex];
            let html = `
                <label style="grid-column: 1 / -1;"><input type="radio" name="mOpt" value="AUT" ${p.mode === 'AUT' ? 'checked' : ''}> AUT (Automatic)</label>
                <label style="grid-column: 1 / -1;"><input type="radio" name="mOpt" value="MAN" ${p.mode === 'MAN' ? 'checked' : ''}> MAN (Manual)</label>
                <label style="grid-column: 1 / -1;"><input type="radio" name="mOpt" value="CAS" ${p.mode === 'CAS' ? 'checked' : ''}> CAS (Cascade)</label>
            `;
            openModal(`Select Target Mode (Plant #${state.activePlantIndex + 1})`, html, () => {
                let sel = document.querySelector('input[name="mOpt"]:checked');
                if (sel) {
                    p.mode = sel.value;
                    sendModeToServer(state.activePlantIndex, p.mode);
                    updateUIReadouts();
                }
            });
        }

        function openValueDialog(target) {
            const p = state.plants[state.activePlantIndex];
            if (target === "MV" && p.mode !== "MAN") {
                openModal("Peringatan", "<p style='color:#FF1744; grid-column:1/-1;'>Perubahan MV hanya diperbolehkan pada Mode MANUAL (MAN)!</p>", null, false);
                return;
            }
            let currVal = target === "MV" ? safeNum(p.mv, 0) : pctToEu(p.sp_pct);
            let html = `
                <label>Enter ${target} Target Value (Plant #${state.activePlantIndex + 1}):</label>
                <input type="number" id="valInput" step="any" value="${currVal.toFixed(1)}">
            `;
            openModal(`Change ${target} Value`, html, () => {
                let valInput = document.getElementById("valInput");
                if (valInput) {
                    let v = safeNum(valInput.value, currVal);
                    if (target === "MV") {
                        p.mv = Math.max(0, Math.min(100, v));
                        sendMvToServer(state.activePlantIndex, p.mv);
                    } else {
                        p.sp_pct = euToPct(Math.max(state.eu_min, Math.min(state.eu_max, v)));
                        sendSpToServer(state.activePlantIndex, p.sp_pct);
                    }
                    updateUIReadouts();
                }
            });
        }

        function openConfigDialog() {
            const p = state.plants[state.activePlantIndex];
            let isLinActive = p.pid.enableLinearization;

            let html = `
                <label>Kc (Gain):</label><input type="number" id="cfgKc" step="any" value="${Math.abs(p.pid.Kc)}">
                <label>Ti (s):</label><input type="number" id="cfgTi" step="any" value="${p.pid.Ti}">
                <label>Td (s):</label><input type="number" id="cfgTd" step="any" value="${p.pid.Td}">
                
                <label>Control Action:</label>
                <select id="cfgAction">
                    <option value="DIRECT" ${p.pid.action === 'DIRECT' ? 'selected' : ''}>Direct Acting</option>
                    <option value="REVERSE" ${p.pid.action === 'REVERSE' ? 'selected' : ''}>Reverse Acting</option>
                </select>

                <label>Tipe Valve:</label>
                <select id="cfgValveType">
                    <option value="FC" ${p.pid.valveType === 'FC' ? 'selected' : ''}>FC (Fail Closed)</option>
                    <option value="FO" ${p.pid.valveType === 'FO' ? 'selected' : ''}>FO (Fail Open)</option>
                </select>

                <label>Linierisasi Valve:</label>
                <select id="cfgLinear" onchange="toggleLinearizationRInput(this.value)">
                    <option value="OFF" ${!isLinActive ? 'selected' : ''}>NON-AKTIF</option>
                    <option value="ON" ${isLinActive ? 'selected' : ''}>AKTIF (Eq%)</option>
                </select>

                <label>Rangeability (R):</label>
                <input type="number" id="cfgR" step="any" value="${p.pid.R}" ${!isLinActive ? 'disabled' : ''}>

                <label>EU Unit:</label><input type="text" id="cfgUnit" value="${state.eu_unit}">
                <label>EU Min:</label><input type="number" id="cfgMin" step="any" value="${state.eu_min}">
                <label>EU Max:</label><input type="number" id="cfgMax" value="${state.eu_max}">
            `;

            openModal(`Parameters Config (PID #${state.activePlantIndex + 1})`, html, () => {
                const kcEl = document.getElementById("cfgKc");
                const tiEl = document.getElementById("cfgTi");
                const tdEl = document.getElementById("cfgTd");
                const actEl = document.getElementById("cfgAction");
                const vTypeEl = document.getElementById("cfgValveType");
                const linEl = document.getElementById("cfgLinear");
                const rEl = document.getElementById("cfgR");
                const unitEl = document.getElementById("cfgUnit");
                const minEl = document.getElementById("cfgMin");
                const maxEl = document.getElementById("cfgMax");

                if (kcEl) p.pid.Kc = Math.abs(safeNum(kcEl.value, p.pid.Kc));
                if (tiEl) p.pid.Ti = safeNum(tiEl.value, p.pid.Ti);
                if (tdEl) p.pid.Td = safeNum(tdEl.value, p.pid.Td);

                if (actEl) p.pid.action = actEl.value;
                if (vTypeEl) p.pid.valveType = vTypeEl.value;

                if (linEl) p.pid.enableLinearization = (linEl.value === "ON");
                if (rEl) p.pid.R = safeNum(rEl.value, p.pid.R);

                if (unitEl) state.eu_unit = unitEl.value || "%";
                if (minEl) state.eu_min = safeNum(minEl.value, 0.0);

                let oldEuMax = state.eu_max;
                if (maxEl) state.eu_max = safeNum(maxEl.value, 100.0);

                sendPidConfigToServer(state.activePlantIndex, p.pid);

                if (state.eu_max !== oldEuMax) {
                    sendEuMaxToServer(state.eu_max);
                }

                const lblPvUnit = document.getElementById("lblPvUnit");
                const lblSvUnit = document.getElementById("lblSvUnit");
                if (lblPvUnit) lblPvUnit.innerText = state.eu_unit;
                if (lblSvUnit) lblSvUnit.innerText = state.eu_unit;

                updateUIReadouts();
            });
        }

        function acknowledgeAlarm() { state.alarmAck = true; }

        window.onload = () => {
            populatePlantDropdown();
            setupFaceplateEvents();
            initWebSocket();
            if (window.innerWidth <= 768) {
                switchMobileTab('controller');
            } else {
                drawYokogawaFaceplate();
                drawTrendChart();
            }
            updateTrendConfig();
        };

        document.addEventListener("DOMContentLoaded", function () {
            const select = document.getElementById("cbPlantSelect");
            const totalPlants = 50;
            const plantsPerGroup = 10;

            for (let i = 0; i < totalPlants; i += plantsPerGroup) {
                const start = i + 1;
                const end = i + plantsPerGroup;

                // Buat grup baru
                const group = document.createElement("optgroup");
                group.label = `Plant ${start} - ${end}`;

                // Isi grup dengan 10 option
                for (let j = start; j <= end; j++) {
                    const option = document.createElement("option");
                    option.value = j - 1; // Index 0..49
                    option.textContent = `Plant #${j}`;
                    group.appendChild(option);
                }

                select.appendChild(group);
            }
        });
    </script>

